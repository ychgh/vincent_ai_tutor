  },
  {
    "id": 2,
    "difficulty": "complex familiar",
    "question": "Write a decorator that logs the execution time of a function. Show the code and explain each part."
  },
  {
    "id": 3,
    "difficulty": "complex unfamiliar",
    "question": "Design a decorator-based access control system for a web API. How would you use decorators to enforce role-based permissions? Explain with code examples."
  }
]
